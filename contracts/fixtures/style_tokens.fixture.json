      "headerTitle": 12,
      "contact": 9,
      "sectionHeading": 12,
      "itemTitle": 11,
      "itemSubtitle": 10,
      "body": 9.5,
      "meta": 9,
      "unit": "pt"
    },
    "lineHeight": 1.45
  },
  "spacing": {
    "sectionSpacing": 14,
    "itemSpacing": 10,
    "bulletSpacing": 4,
    "headerBottomSpacing": 12,
    "unit": "pt"
  },
  "colors": {
