{
  "schema_version": "1.0.0",
  "templateId": "classic_single_column",
  "pageSize": "A4",
  "margins": {
    "top": 36,
    "bottom": 36,
    "left": 40,
    "right": 40,
    "unit": "pt"
  },
  "typography": {
    "baseFontFamily": "Inter",
    "headingFontFamily": "Inter",
    "nameFontFamily": "Inter",
    "fontSizeScale": 1.0,
    "fontSizes": {
